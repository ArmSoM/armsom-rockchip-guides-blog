---
layout: null
---
[{% assign all_articles = site.articles | concat: site.articles_zh | concat: site.articles_ru | concat: site.articles_de %}{% for article in all_articles %}{% assign minutes = article.content | number_of_words | plus: 199 | divided_by: 200 | at_least: 1 %}{% assign empty_products = '' | split: ',' %}{% assign reference_products = article.reference_products | default: empty_products %}{% assign related_products = article.products | default: empty_products | concat: reference_products | uniq %}{"title":{{ article.title | jsonify }},"description":{{ article.description | jsonify }},"url":{{ article.url | relative_url | jsonify }},"lang":{{ article.lang | jsonify }},"category":{{ article.category | jsonify }},"products":{{ related_products | jsonify }},"tags":{{ article.tags | jsonify }},"date":{{ article.date | date: '%Y-%m-%d' | jsonify }},"name":{{ article.translation_key | jsonify }},"minutes":{{ minutes }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
