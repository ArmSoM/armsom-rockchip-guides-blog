source "https://rubygems.org"

# Match the supported GitHub Pages Jekyll environment during local previews.
gem "github-pages", group: :jekyll_plugins

# Ruby 3+ no longer bundles WEBrick, which Jekyll uses for `serve`.
gem "webrick"

# Windows does not ship IANA timezone data used by Ruby/Jekyll.
gem "tzinfo-data", platforms: %i[mingw x64_mingw mswin jruby]
